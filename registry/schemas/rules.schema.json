{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/famulare/enterovirus-genbank-curated/raw/main/registry/schemas/rules.schema.json",
  "title": "Deterministic curation rule",
  "description": "A versioned deterministic rule used to derive or project release values.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "rule_id",
    "rule_version",
    "field_name",
    "description",
    "implementation",
    "parameters",
    "status"
  ],
  "properties": {
    "rule_id": {
      "type": "string",
      "pattern": "^R-[A-Z0-9][A-Z0-9_-]*$"
    },
    "rule_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "field_name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "implementation": {
      "type": "string",
      "minLength": 1,
      "description": "Import path or stable implementation key."
    },
    "parameters": {
      "type": "object",
      "description": "All thresholds and constants required by the rule."
    },
    "status": {
      "type": "string",
      "enum": ["active", "deprecated"]
    }
  }
}
